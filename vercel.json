{
  "version": 2,
  "builds": [
    {
      "src": "public/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/apple",
      "status": 302,
      "headers": {
        "Location": "/download"
      }
    },
    {
      "src": "/a",
      "status": 302,
      "headers": {
        "Location": "/download"
      }
    },
    {
      "src": "/google",
      "status": 302,
      "headers": {
        "Location": "/download"
      }
    },
    {
      "src": "/g",
      "status": 302,
      "headers": {
        "Location": "/download"
      }
    },
    {
      "src": "/download",
      "dest": "/public/download/index.html"
    },
    {
      "src": "/(.*)",
      "dest": "/public/$1"
    }
  ]
}
